{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Asistente de IA personal avanzado",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron . --disable-gpu --no-sandbox",
    "cli": "ts-node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "axios": "^1.6.0",
    "conf": "^12.0.0",
    "dotenv": "^16.3.0",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.5",
    "groq-sdk": "^0.4.0",
    "js-yaml": "^4.1.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.28.0",
    "pino": "^8.18.0",
    "pino-pretty": "^11.0.0",
    "say": "^0.16.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "electron": "^29.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "author": {
    "name": "ZATT999",
    "email": "zatt999mc@gmail.com"
  },
  "homepage": "https://github.com/ZATT999/jarvis",
  "build": {
    "appId": "com.zatt999.jarvis",
    "productName": "Jarvis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "config/default.yaml",
      "package.json"
    ],
    "asar": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "ZATT999 <zatt999mc@gmail.com>"
    }
  }
}
